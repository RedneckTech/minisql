REM ==============================================================
REM  verify1.bas   -   MiniSQL verification part
REM  Checks SQL_RESULT$ contents and status codes for every
REM  feature.  Prints one progress line per check, details on
REM  failure, and a final PASS/FAIL summary.
REM ==============================================================
START:
COMMON SQL_CMD$, SQL_DB$, SQL_STMT$, SQL_MODE$, SQL_RESULT$
COMMON SQL_STATUS, SQL_MSG$

PASS = 0
FAIL = 0
LF$ = CHR$(10)
SQL_DB$ = "VERIFY1"
SQL_MODE$ = "RW"
SQL_CMD$ = "INITDB"
GOSUB T_RUNSQL
TEST$ = "C00 INITDB"
GOSUB T_SHOW
WSTAT = 0
GOSUB T_CKST

REM ---------- setup table v1 ----------
TEST$ = "C00B CREATE v1"
GOSUB T_SHOW
SQL_STMT$ = "CREATE TABLE v1 (name,age,city) PK KEY"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00C INSERT r1"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r1 VALUES (Alice,25,Chicago)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00D INSERT r2"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r2 VALUES (Bob,30,Boston)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00E INSERT r3"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r3 VALUES (Carol,22,Chicago)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00F INSERT r4"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r4 VALUES (Dave,35,Denver)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00G INSERT r5"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r5 VALUES (Eve,28,Austin)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST

REM ---------- SELECT / WHERE ----------
TEST$ = "C01 SELECT KEY exact"
GOSUB T_SHOW
SQL_STMT$ = "SELECT * FROM v1 WHERE KEY=r1"
GOSUB T_EXEC
WANT$ = "R|key|r1|name=Alice|age=25|city=Chicago" + LF$
GOT$ = SQL_RESULT$
GOSUB T_CKEQ

TEST$ = "C02 SELECT cols exact"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE KEY=r2"
GOSUB T_EXEC
WANT$ = "R|key|r2|name=Bob" + LF$
GOT$ = SQL_RESULT$
GOSUB T_CKEQ

TEST$ = "C03 WHERE city eq"
GOSUB T_SHOW
SQL_STMT$ = "SELECT * FROM v1 WHERE city=Chicago"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Alice": GOSUB T_CKCONT
WANT$ = "name=Carol": GOSUB T_CKCONT
WANT$ = "name=Bob": GOSUB T_CKABS

TEST$ = "C04 WHERE age gt"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE age>25"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 3: GOSUB T_CKNUM
WANT$ = "name=Bob": GOSUB T_CKCONT
WANT$ = "name=Dave": GOSUB T_CKCONT
WANT$ = "name=Eve": GOSUB T_CKCONT
WANT$ = "name=Alice": GOSUB T_CKABS

TEST$ = "C05 WHERE age ge"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE age>=30"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Bob": GOSUB T_CKCONT
WANT$ = "name=Dave": GOSUB T_CKCONT

TEST$ = "C06 WHERE age lt"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE age<26"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Alice": GOSUB T_CKCONT
WANT$ = "name=Carol": GOSUB T_CKCONT

TEST$ = "C07 WHERE age le"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE age<=25"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Alice": GOSUB T_CKCONT
WANT$ = "name=Carol": GOSUB T_CKCONT

TEST$ = "C08 WHERE ne"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE city<>Chicago"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 3: GOSUB T_CKNUM
WANT$ = "name=Bob": GOSUB T_CKCONT
WANT$ = "name=Dave": GOSUB T_CKCONT
WANT$ = "name=Eve": GOSUB T_CKCONT
WANT$ = "name=Alice": GOSUB T_CKABS

TEST$ = "C09 LIKE contains"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE city LIKE %hic%"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Carol": GOSUB T_CKCONT

TEST$ = "C10 LIKE prefix"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE city LIKE Chi%"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Alice": GOSUB T_CKCONT

TEST$ = "C11 LIKE suffix"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE city LIKE %ago"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Alice": GOSUB T_CKCONT

TEST$ = "C12 WHERE AND"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE city=Chicago AND age>23"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 1: GOSUB T_CKNUM
WANT$ = "name=Alice": GOSUB T_CKCONT

TEST$ = "C13 WHERE OR"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE city=Chicago OR city=Denver"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 3: GOSUB T_CKNUM
WANT$ = "name=Carol": GOSUB T_CKCONT
WANT$ = "name=Dave": GOSUB T_CKCONT

TEST$ = "C14 WHERE AND/OR"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE city=Chicago"
SQL_STMT$ = SQL_STMT$ + " AND age>23 OR city=Denver"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Alice": GOSUB T_CKCONT
WANT$ = "name=Dave": GOSUB T_CKCONT
WANT$ = "name=Carol": GOSUB T_CKABS

TEST$ = "C15 ORDER name ASC"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 ORDER BY name ASC"
GOSUB T_EXEC
GOTN = INSTR(SQL_RESULT$, "name=Alice")
WANTN = INSTR(SQL_RESULT$, "name=Bob")
GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Bob")
WANTN = INSTR(SQL_RESULT$, "name=Carol")
GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Carol")
WANTN = INSTR(SQL_RESULT$, "name=Dave")
GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Dave")
WANTN = INSTR(SQL_RESULT$, "name=Eve")
GOSUB T_CKPOS

TEST$ = "C16 ORDER name DESC"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 ORDER BY name DESC"
GOSUB T_EXEC
GOTN = INSTR(SQL_RESULT$, "name=Eve")
WANTN = INSTR(SQL_RESULT$, "name=Dave")
GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Dave")
WANTN = INSTR(SQL_RESULT$, "name=Carol")
GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Carol")
WANTN = INSTR(SQL_RESULT$, "name=Bob")
GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Bob")
WANTN = INSTR(SQL_RESULT$, "name=Alice")
GOSUB T_CKPOS

TEST$ = "C17 LIMIT"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 LIMIT 2"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM

TEST$ = "C18 ORDER + LIMIT"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 ORDER BY name ASC LIMIT 2"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 2: GOSUB T_CKNUM
WANT$ = "name=Alice": GOSUB T_CKCONT
WANT$ = "name=Bob": GOSUB T_CKCONT
WANT$ = "name=Carol": GOSUB T_CKABS

TEST$ = "C19 DISTINCT"
GOSUB T_SHOW
SQL_STMT$ = "SELECT DISTINCT city FROM v1"
GOSUB T_EXEC
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 4: GOSUB T_CKNUM
WANT$ = "city=Boston": GOSUB T_CKCONT
WANT$ = "city=Denver": GOSUB T_CKCONT
WANT$ = "city=Austin": GOSUB T_CKCONT
WANT$ = "city=Chicago"
GOSUB T_OCC
GOTN = OCC: WANTN = 1: GOSUB T_CKNUM

TEST$ = "C20 SELECT 2 cols"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name,city FROM v1"
GOSUB T_EXEC
WANT$ = "name=Alice": GOSUB T_CKCONT
WANT$ = "city=Chicago": GOSUB T_CKCONT
WANT$ = "|age=": GOSUB T_CKABS

TEST$ = "C21 COUNT all"
GOSUB T_SHOW
SQL_STMT$ = "SELECT COUNT(*) FROM v1"
GOSUB T_EXEC
WANT$ = "COUNT=5"
GOT$ = SQL_RESULT$
GOSUB T_CKEQ

TEST$ = "C22 COUNT where"
GOSUB T_SHOW
SQL_STMT$ = "SELECT COUNT(*) FROM v1 WHERE age>25"
GOSUB T_EXEC
WANT$ = "COUNT=3"
GOT$ = SQL_RESULT$
GOSUB T_CKEQ

TEST$ = "C23 SELECT missing key"
GOSUB T_SHOW
SQL_STMT$ = "SELECT * FROM v1 WHERE KEY=zzz"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
WANT$ = ""
GOT$ = SQL_RESULT$
GOSUB T_CKEQ

REM ---------- UPDATE ----------
TEST$ = "C23B LIMIT 0"
GOSUB T_SHOW
SQL_STMT$ = "SELECT * FROM v1 LIMIT 0"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
GOSUB T_ROWS
GOTN = ROWCNT: WANTN = 0: GOSUB T_CKNUM

REM ---------- summary ----------
PRINT ""
PRINT "VERIFY RESULTS"
PRINT "PASS: "; PASS
PRINT "FAIL: "; FAIL
IF FAIL = 0 THEN PRINT "ALL CHECKS PASSED"
IF FAIL > 0 THEN PRINT "THERE ARE FAILURES"
END

REM ==============================================================
REM  Helper routines
REM ==============================================================
T_RUNSQL:
    SQL_STATUS = 0
    SQL_MSG$ = ""
    SQL_RESULT$ = ""
    CHAIN "minisql.bas"
    RETURN

T_EXEC:
    SQL_CMD$ = "EXEC"
    GOSUB T_RUNSQL
    RETURN

T_SHOW:
    PRINT ".";
    RETURN

T_CKST:
    IF SQL_STATUS = WSTAT THEN
        PASS = PASS + 1
    ELSE
        FAIL = FAIL + 1
        PRINT "  FAIL STATUS="; SQL_STATUS; " WANT="; WSTAT
        PRINT "  MSG="; SQL_MSG$
    END IF
    RETURN

T_CKEQ:
    IF GOT$ = WANT$ THEN
        PASS = PASS + 1
    ELSE
        FAIL = FAIL + 1
        PRINT "  FAIL WANT=["; LEFT$(WANT$, 100); "]"
        PRINT "  FAIL GOT =["; LEFT$(GOT$, 100); "]"
    END IF
    RETURN

T_CKCONT:
    IF INSTR(SQL_RESULT$, WANT$) > 0 THEN
        PASS = PASS + 1
    ELSE
        FAIL = FAIL + 1
        PRINT "  FAIL MISSING ["; LEFT$(WANT$, 100); "]"
        PRINT "  RESULT=["; LEFT$(SQL_RESULT$, 100); "]"
    END IF
    RETURN

T_CKMSG:
    IF INSTR(SQL_MSG$, WANT$) > 0 THEN
        PASS = PASS + 1
    ELSE
        FAIL = FAIL + 1
        PRINT "  FAIL MSG MISSING ["; WANT$; "]"
        PRINT "  MSG=["; SQL_MSG$; "]"
    END IF
    RETURN

T_CKABS:
    IF INSTR(SQL_RESULT$, WANT$) = 0 THEN
        PASS = PASS + 1
    ELSE
        FAIL = FAIL + 1
        PRINT "  FAIL FOUND ["; LEFT$(WANT$, 100); "]"
        PRINT "  RESULT=["; LEFT$(SQL_RESULT$, 100); "]"
    END IF
    RETURN

T_ROWS:
    ROWCNT = LEN(SQL_RESULT$) - LEN(REPLACE$(SQL_RESULT$, LF$, ""))
    RETURN

T_OCC:
    OCC = 0
    IF LEN(WANT$) > 0 THEN
        OCC = (LEN(SQL_RESULT$) - LEN(REPLACE$(SQL_RESULT$, WANT$, "")))
        OCC = OCC / LEN(WANT$)
    END IF
    RETURN

T_CKNUM:
    IF GOTN = WANTN THEN
        PASS = PASS + 1
    ELSE
        FAIL = FAIL + 1
        PRINT "  FAIL NUM="; GOTN; " WANT="; WANTN
        PRINT "  RESULT=["; LEFT$(SQL_RESULT$, 100); "]"
    END IF
    RETURN

T_CKPOS:
    IF GOTN > 0 AND WANTN > 0 AND GOTN < WANTN THEN
        PASS = PASS + 1
    ELSE
        FAIL = FAIL + 1
        PRINT "  FAIL POS "; GOTN; " NOT BEFORE "; WANTN
        PRINT "  RESULT=["; LEFT$(SQL_RESULT$, 100); "]"
    END IF
    RETURN
