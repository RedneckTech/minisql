GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Dave")
WANTN = INSTR(SQL_RESULT$, "name=Carol")
GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Carol")
WANTN = INSTR(SQL_RESULT$, "name=Bob")
GOSUB T_CKPOS
GOTN = INSTR(SQL_RESULT$, "name=Bob")
WANTN = INSTR(SQL_RESULT$, "name=Alice")
GOSUB T_CKPOS

TEST$ = "C17 LIMIT"
GOSUB T_SHOW
