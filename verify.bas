REM ==============================================================
REM  verify.bas   -   MiniSQL behavioral verification suite
REM  Checks SQL_RESULT$ contents and status codes for every
REM  feature.  Prints one progress line per check, details on
REM  failure, and a final PASS/FAIL summary.
REM ==============================================================
START:
COMMON SQL_CMD$, SQL_DB$, SQL_STMT$, SQL_MODE$, SQL_RESULT$
COMMON SQL_STATUS, SQL_MSG$

PASS = 0
FAIL = 0
LF$ = CHR$(10)
SQL_DB$ = "VERIFYDB"
SQL_MODE$ = "RW"
SQL_CMD$ = "INITDB"
GOSUB T_RUNSQL
TEST$ = "C00 INITDB"
GOSUB T_SHOW
WSTAT = 0
GOSUB T_CKST

REM ---------- setup table v1 ----------
TEST$ = "C00B CREATE v1"
GOSUB T_SHOW
SQL_STMT$ = "CREATE TABLE v1 (name,age,city) PK KEY"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00C INSERT r1"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r1 VALUES (Alice,25,Chicago)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00D INSERT r2"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r2 VALUES (Bob,30,Boston)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00E INSERT r3"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r3 VALUES (Carol,22,Chicago)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00F INSERT r4"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r4 VALUES (Dave,35,Denver)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST
TEST$ = "C00G INSERT r5"
GOSUB T_SHOW
SQL_STMT$ = "INSERT INTO v1 KEY r5 VALUES (Eve,28,Austin)"
GOSUB T_EXEC
WSTAT = 0
GOSUB T_CKST

REM ---------- SELECT / WHERE ----------
TEST$ = "C01 SELECT KEY exact"
GOSUB T_SHOW
SQL_STMT$ = "SELECT * FROM v1 WHERE KEY=r1"
GOSUB T_EXEC
WANT$ = "R|key|r1|name=Alice|age=25|city=Chicago" + LF$
GOT$ = SQL_RESULT$
GOSUB T_CKEQ

TEST$ = "C02 SELECT cols exact"
GOSUB T_SHOW
SQL_STMT$ = "SELECT name FROM v1 WHERE KEY=r2"
GOSUB T_EXEC
WANT$ = "R|key|r2|name=Bob" + LF$
